# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or expose provider keys in frontend VITE_* variables.
DATABASE_URL=postgresql+psycopg://incidentiq:change-me@localhost:5432/incidentiq
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incidentiq-hackathon-demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional; defaults to false. Synthetic retain smoke tests are opt-in only.
HINDSIGHT_SMOKE_TEST_RETAIN=false
